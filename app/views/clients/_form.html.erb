<% editing = client.persisted? %>
<% document_options = if editing
  client.person_type == "natural" ? [["Cédula", "cedula"], ["Pasaporte", "pasaporte"]] : [["RIF", "rif"]]
else
  [["Cédula", "cedula"], ["Pasaporte", "pasaporte"], ["RIF", "rif"]]
end %>

<%= form_with model: client, class: "needs-validation", data: { controller: editing ? nil : "client-form" } do |f| %>
  <% if client.errors.any? %>
    <div class="alert alert-danger">
      <% messages = client_error_messages(client) %>
      <h6 class="mb-2"><%= pluralize(messages.count, "error") %> impidieron guardar el cliente:</h6>
      <ul class="mb-0">
        <% messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Tipo de persona</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :person_type, "Tipo de persona", class: "form-label" %>
          <% if editing %>
            <p class="form-control-plaintext mb-0 fw-semibold">
              <%= client.person_type == "natural" ? "Natural" : "Jurídica" %>
            </p>
            <small class="text-muted">El tipo de persona no puede modificarse.</small>
          <% else %>
            <%= f.select :person_type,
                  options_for_select([["Natural", "natural"], ["Jurídica", "juridico"]], client.person_type),
                  { include_blank: "Seleccione..." },
                  class: "form-select",
                  data: { client_form_target: "personType", action: "change->client-form#toggle" } %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if !editing || client.person_type == "natural" %>
    <div class="card shadow-sm mb-4" data-client-form-target="naturalBlock">
      <div class="card-header bg-white fw-semibold">Datos de persona natural</div>
      <div class="card-body">
        <%= f.fields_for :natural_person do |np| %>
          <div class="row g-3">
            <div class="col-md-8">
              <%= np.label :full_name, "Nombre completo", class: "form-label" %>
              <%= np.text_field :full_name, class: "form-control" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if !editing || client.person_type == "juridico" %>
    <div class="card shadow-sm mb-4" data-client-form-target="legalBlock">
      <div class="card-header bg-white fw-semibold">Datos de persona jurídica</div>
      <div class="card-body">
        <%= f.fields_for :legal_entity do |le| %>
          <div class="row g-3">
            <div class="col-md-8">
              <%= le.label :company_name, "Razón social", class: "form-label" %>
              <%= le.text_field :company_name, class: "form-control" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Documento</div>
    <div class="card-body">
      <%= f.fields_for :documents do |doc| %>
        <div class="row g-3">
          <div class="col-md-4">
            <%= doc.label :document_type, "Tipo de documento", class: "form-label" %>
            <%= doc.select :document_type,
                  options_for_select(document_options, doc.object.document_type),
                  { include_blank: "Seleccione..." },
                  class: "form-select",
                  data: editing ? {} : { client_form_target: "documentType" } %>
          </div>
          <div class="col-md-5">
            <%= doc.label :document_number, "Número de documento", class: "form-label" %>
            <%= doc.text_field :document_number, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= doc.label :issued_at, "Fecha de emisión", class: "form-label" %>
            <%= doc.date_field :issued_at, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= doc.label :expires_at, "Fecha de vencimiento", class: "form-label" %>
            <%= doc.date_field :expires_at, class: "form-control" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Contacto</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :email, "Correo electrónico", class: "form-label" %>
          <%= f.email_field :email, class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= f.label :phone_primary, "Teléfono principal", class: "form-label" %>
          <%= f.text_field :phone_primary, class: "form-control", placeholder: "0412..." %>
        </div>
        <div class="col-md-6">
          <%= f.label :phone_secondary, "Teléfono secundario", class: "form-label" %>
          <%= f.text_field :phone_secondary, class: "form-control", placeholder: "Opcional" %>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Guardar cliente", class: "btn btn-secondary" %>
    <%= link_to "Cancelar", clients_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
