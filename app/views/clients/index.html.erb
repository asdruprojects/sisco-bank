<% content_for :title, "Clientes" %>

<div data-controller="delete-confirm">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Clientes</h1>
    <%= link_to new_client_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i> Nuevo cliente
    <% end %>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <%= form_with url: clients_path, method: :get do |f| %>
        <div class="row g-3 align-items-end">
          <div class="col-md-4">
            <%= f.label :name, "Buscar por nombre", class: "form-label" %>
            <%= f.text_field :name, value: params[:name], class: "form-control", placeholder: "Nombre o razón social" %>
          </div>
          <div class="col-md-3">
            <%= f.label :document, "Buscar por documento", class: "form-label" %>
            <%= f.text_field :document, value: params[:document], class: "form-control", placeholder: "Número" %>
          </div>
          <div class="col-md-3">
            <%= f.label :person_type, "Tipo de persona", class: "form-label" %>
            <%= f.select :person_type,
                  options_for_select([["Todos", ""], ["Natural", "natural"], ["Jurídica", "juridico"]], params[:person_type]),
                  {},
                  class: "form-select" %>
          </div>
          <div class="col-md-2">
            <div class="d-flex gap-2">
              <%= f.submit "Filtrar", class: "btn btn-primary flex-fill" %>
              <%= link_to clients_path, class: "btn btn-outline-secondary", title: "Limpiar filtros" do %>
                <i class="bi bi-arrow-counterclockwise"></i>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if @clients.any? %>
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="col-name">Nombre / Razón social</th>
              <th>Tipo</th>
              <th>Correo</th>
              <th>Teléfono</th>
              <th>Registrado</th>
              <th class="text-center text-nowrap col-actions">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @clients.each do |client| %>
              <tr>
                <td class="col-name"><%= client.display_name %></td>
                <td>
                  <% if client.person_type == "natural" %>
                    <span class="badge text-bg-info">Natural</span>
                  <% else %>
                    <span class="badge text-bg-secondary">Jurídica</span>
                  <% end %>
                </td>
                <td><%= client.email %></td>
                <td class="text-nowrap"><%= client.phone_primary %></td>
                <td class="text-nowrap"><%= client.created_at.strftime("%d/%m/%Y") %></td>
                <td class="text-center text-nowrap col-actions">
                  <div class="d-flex justify-content-center gap-2 flex-nowrap">
                    <%= link_to client_path(client),
                          class: "btn btn-outline-primary btn-sm",
                          title: "Ver" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_client_path(client),
                          class: "btn btn-outline-warning btn-sm",
                          title: "Editar" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            title="Eliminar"
                            data-action="click->delete-confirm#open"
                            data-delete-confirm-client-name-param="<%= client.display_name %>"
                            data-delete-confirm-form-id-param="delete-client-<%= client.id %>">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "pagination" if @pagination[:total_count].positive? %>
    </div>
  <% else %>
    <div class="alert alert-info">No se encontraron clientes.</div>
  <% end %>

  <% @clients.each do |client| %>
    <%= form_with url: client_path(client), method: :delete,
          html: { id: "delete-client-#{client.id}", class: "d-none" } do |f| %>
      <%= f.submit "Eliminar", tabindex: -1, aria: { hidden: true } %>
    <% end %>
  <% end %>

  <div class="modal fade" tabindex="-1" role="dialog" aria-modal="true" data-delete-confirm-target="modal">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0 position-relative">
          <h5 class="modal-title w-100 text-center">Eliminar cliente</h5>
          <button type="button" class="btn-close position-absolute end-0 me-3" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body py-4 text-center">
          <p class="mb-0" style="font-size: 1.0625rem;">
            ¿Estás seguro de que deseas eliminar a <strong data-delete-confirm-target="clientName"></strong>?
          </p>
        </div>
        <div class="modal-footer border-0 pt-0 justify-content-center gap-2">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" data-action="click->delete-confirm#confirm">
            Eliminar
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
