<% content_for :title, @client.display_name %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><%= @client.display_name %></h1>
  <%= link_to "Editar", edit_client_path(@client), class: "btn btn-primary btn-sm" %>
</div>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white fw-semibold">Datos generales</div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Tipo de persona</span>
          <% if @client.person_type == "natural" %>
            <span class="badge text-bg-info">Natural</span>
          <% else %>
            <span class="badge text-bg-success">Jurídica</span>
          <% end %>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted"><%= @client.person_type == "natural" ? "Nombre completo" : "Razón social" %></span>
          <span><%= @client.display_name %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Correo</span>
          <span><%= @client.email %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Teléfono principal</span>
          <span><%= @client.phone_primary %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Teléfono secundario</span>
          <span><%= @client.phone_secondary.presence || "—" %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Registrado</span>
          <span><%= @client.created_at.strftime("%d/%m/%Y %H:%M") %></span>
        </li>
      </ul>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white fw-semibold">Documentos</div>
      <% if @client.documents.any? %>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead class="table-light">
              <tr>
                <th>Tipo</th>
                <th>Número</th>
                <th>Emisión</th>
                <th>Vencimiento</th>
              </tr>
            </thead>
            <tbody>
              <% @client.documents.each do |doc| %>
                <tr>
                  <td><%= doc.document_type.capitalize %></td>
                  <td><%= doc.document_number %></td>
                  <td><%= doc.issued_at.strftime("%d/%m/%Y") %></td>
                  <td><%= doc.expires_at.strftime("%d/%m/%Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="card-body text-muted">Sin documentos registrados.</div>
      <% end %>
    </div>
  </div>
</div>
